# ===== Application =====
# Public URL of the app (used e.g. for meta tags / SEO / absolute links)
# VITE_APP_URL=http://localhost:5173

# ===== API =====
# Base URL of your backend API (leave empty if none)
# VITE_API_URL=http://localhost:5001/api
# VITE_API_URL=https://api.example.com/api

# ===== Authentication (optional) =====
# OAuth client id / tenant, e.g. Auth0, Cognito, Keycloak
# VITE_AUTH_DOMAIN=
# VITE_AUTH_CLIENT_ID=

# ===== Third-party services (optional) =====
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# ===== Runtime =====
# Env flag: 'development' | 'production' | 'staging'
# VITE_ENV=development
# Enable Sentry error tracking (optional)
# VITE_SENTRY_DSN=