PORT=5001
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/fleetly

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
RENTAL_TAX_RATE=0.2

CLIENT_DEVELOPMENT_DOMAIN=http://localhost:5173
CLIENT_PRODUCTION_DOMAIN=https://your-frontend-domain.example
# Optional comma-separated override. If omitted, the two domains above are allowed.
CLIENT_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Facebook OAuth2 (https://developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5001/api/auth/facebook/callback
